#!/usr/bin/env bash
# ============================================================================
# hpmdev — Alliance-HPM-Dev environment CLI
#
#   hpmdev new <name> [--template <t>]   create a project from templates/
#   hpmdev clone [name]                  clone project(s) declared in projects.yaml
#   hpmdev list                          list declared projects and their git state
#   hpmdev sync-config <name>|--all      distribute config/ into project(s)
#   hpmdev doctor                        environment / toolchain health check
#   hpmdev env                           print resolved environment paths
#   hpmdev help
# ============================================================================
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export HPMDEV_ROOT="${HPMDEV_ROOT:-$(cd "${SELF}/../.." && pwd)}"

export HPMDEV_TOOLS_DIR="${HPMDEV_TOOLS_DIR:-${HPMDEV_ROOT}/tools}"
export HPMDEV_CONFIG_DIR="${HPMDEV_CONFIG_DIR:-${HPMDEV_ROOT}/config}"
export HPMDEV_TEMPLATES_DIR="${HPMDEV_TEMPLATES_DIR:-${HPMDEV_ROOT}/templates}"
export HPMDEV_PROJECTS_DIR="${HPMDEV_PROJECTS_DIR:-${HPMDEV_ROOT}/projects}"
export HPMDEV_SHARED_DIR="${HPMDEV_SHARED_DIR:-${HPMDEV_ROOT}/shared}"
export HPMDEV_SDK_DIR="${HPMDEV_SDK_DIR:-${HPMDEV_ROOT}/sdk/hpm_sdk}"
export HPMDEV_MANIFEST="${HPMDEV_MANIFEST:-${HPMDEV_ROOT}/projects.yaml}"
export HPMDEV_DEFAULT_TEMPLATE="${HPMDEV_DEFAULT_TEMPLATE:-hpm5361-4layer}"

C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[1;33m'
C_CYAN=$'\033[0;36m'; C_BOLD=$'\033[1m'; C_NC=$'\033[0m'

info()  { printf '%s[hpmdev]%s %s\n' "$C_GREEN"  "$C_NC" "$*"; }
warn()  { printf '%s[hpmdev]%s %s\n' "$C_YELLOW" "$C_NC" "$*"; }
error() { printf '%s[hpmdev]%s %s\n' "$C_RED"    "$C_NC" "$*" >&2; }
die()   { error "$*"; exit 1; }

env_version() { [ -f "${HPMDEV_CONFIG_DIR}/VERSION" ] && tr -d ' \n' < "${HPMDEV_CONFIG_DIR}/VERSION" || echo unknown; }

usage() {
    sed -n '3,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

manifest_pairs() {
    [ -f "$HPMDEV_MANIFEST" ] || die "manifest not found: $HPMDEV_MANIFEST"
    python3 - "$HPMDEV_MANIFEST" <<'PY'
import sys
try:
    import yaml
except ImportError:
    sys.exit(3)
with open(sys.argv[1]) as f:
    data = yaml.safe_load(f) or {}
for p in (data.get("projects") or []):
    print(f"{p.get('name','')}\t{p.get('url','')}\t{p.get('branch','')}\t{p.get('default_board','')}")
PY
}

project_boards() {
    local dir="$1"
    local name; name="$(basename "$dir")"
    local out=""
    if [ -d "$dir/Board/${name}_board" ]; then out="${name}_board"; fi
    if [ -d "$dir/Board/user_board" ]; then out="${out:+$out }user_board"; fi
    local b
    for b in "$dir"/Board/*_board; do
        [ -d "$b" ] || continue
        local n; n="$(basename "$b")"
        case " $out " in *" $n "*) ;; *) out="${out:+$out }$n" ;; esac
    done
    [ -n "$out" ] && echo "$out" || echo user_board
}

project_board() {
    set -- $(project_boards "$1")
    echo "$1"
}

sync_config_one() {
    local dir="$1"
    [ -d "$dir" ] || { warn "skip (not found): $dir"; return 1; }
    [ -d "$HPMDEV_CONFIG_DIR" ] || die "config dir not found: $HPMDEV_CONFIG_DIR"
    local board; board="$(project_board "$dir")"

    for pair in "clang-format:.clang-format" "clang-tidy:.clang-tidy" \
                "editorconfig:.editorconfig" "cspell.json:.cspell.json"; do
        local src="${pair%%:*}" dst="${pair##*:}"
        [ -f "$HPMDEV_CONFIG_DIR/$src" ] || continue
        cp "$HPMDEV_CONFIG_DIR/$src" "$dir/$dst"
    done

    if [ -f "$HPMDEV_CONFIG_DIR/clangd.tpl" ]; then
        python3 - "$HPMDEV_CONFIG_DIR/clangd.tpl" "$dir/.clangd" "$(project_boards "$dir")" <<'PY'
import sys
tpl, out, boards = sys.argv[1], sys.argv[2], sys.argv[3].split()
lines = "\n".join("    - -I../Board/%s" % b for b in boards)
s = open(tpl, encoding="utf-8").read().replace("    - -I../Board/@BOARDS@", lines)
open(out, "w", encoding="utf-8").write(s)
PY
    fi

    if [ -f "$HPMDEV_CONFIG_DIR/AGENTS.md" ]; then
        local marker='## 项目附加约定'
        local tmp; tmp="$(mktemp)"
        awk -v m="$marker" 'index($0,m)==1{exit} {print}' "$HPMDEV_CONFIG_DIR/AGENTS.md" > "$tmp"
        if [ -f "$dir/AGENTS.md" ] && grep -qF "$marker" "$dir/AGENTS.md"; then
            awk -v m="$marker" 'found||index($0,m)==1{found=1; print}' "$dir/AGENTS.md" >> "$tmp"
        else
            printf '\n%s\n\n' "$marker" >> "$tmp"
            printf '<!-- 各项目在此追加本地约定，sync-config 不会覆盖本小节。 -->\n' >> "$tmp"
        fi
        mv "$tmp" "$dir/AGENTS.md"
    fi

    if [ "$(basename "$(dirname "$dir")")" = "projects" ]; then
        write_workspace_file "$(basename "$dir")" "$dir" "$board"
    fi

    info "config synced -> ${dir} (board=${board})"
}

cmd_env() {
    printf '%s\n' \
        "HPMDEV_ROOT          = $HPMDEV_ROOT" \
        "HPMDEV_TOOLS_DIR     = $HPMDEV_TOOLS_DIR" \
        "HPMDEV_CONFIG_DIR    = $HPMDEV_CONFIG_DIR" \
        "HPMDEV_TEMPLATES_DIR = $HPMDEV_TEMPLATES_DIR" \
        "HPMDEV_PROJECTS_DIR  = $HPMDEV_PROJECTS_DIR" \
        "HPMDEV_SHARED_DIR    = $HPMDEV_SHARED_DIR" \
        "HPMDEV_SDK_DIR       = $HPMDEV_SDK_DIR" \
        "HPM_SDK_BASE         = ${HPM_SDK_BASE:-<unset>}" \
        "env version          = $(env_version)"
}

cmd_doctor() {
    local fail=0
    printf '%s== hpmdev doctor ==%s\n' "$C_BOLD" "$C_NC"
    check_dir() { if [ -d "$2" ]; then printf '  %s[ok]%s %-22s %s\n' "$C_GREEN" "$C_NC" "$1" "$2"; else printf '  %s[!!]%s %-22s missing: %s\n' "$C_RED" "$C_NC" "$1" "$2"; fail=1; fi; }
    check_cmd() {
        if command -v "$1" >/dev/null 2>&1; then
            printf '  %s[ok]%s %-22s %s\n' "$C_GREEN" "$C_NC" "$1" "$(command -v "$1")"
        elif [ "${2:-required}" = optional ]; then
            printf '  %s[--]%s %-22s not found (optional)\n' "$C_YELLOW" "$C_NC" "$1"
        else
            printf '  %s[!!]%s %-22s not found\n' "$C_RED" "$C_NC" "$1"; fail=1
        fi
    }
    check_dir "env root"        "$HPMDEV_ROOT"
    check_dir "config"          "$HPMDEV_CONFIG_DIR"
    check_dir "templates"       "$HPMDEV_TEMPLATES_DIR"
    check_dir "projects"        "$HPMDEV_PROJECTS_DIR"
    check_dir "shared"          "$HPMDEV_SHARED_DIR"
    check_dir "hpm_sdk"         "$HPMDEV_SDK_DIR"
    check_cmd riscv32-unknown-elf-gcc
    check_cmd cmake
    check_cmd ninja
    check_cmd python3
    check_cmd openocd optional
    check_cmd JLinkExe optional
    if [ -n "${HPM_SDK_BASE:-}" ] && [ "$HPM_SDK_BASE" != "$HPMDEV_SDK_DIR" ]; then
        printf '  %s[!!]%s %-22s HPM_SDK_BASE=%s (expected %s)\n' "$C_YELLOW" "$C_NC" "sdk env" "$HPM_SDK_BASE" "$HPMDEV_SDK_DIR"; fail=1
    else
        printf '  %s[ok]%s %-22s %s\n' "$C_GREEN" "$C_NC" "HPM_SDK_BASE" "${HPM_SDK_BASE:-<unset>}"
    fi
    if [ "$(git -C "$HPMDEV_ROOT" config core.fileMode 2>/dev/null)" = "false" ]; then
        printf '  %s[ok]%s %-22s false\n' "$C_GREEN" "$C_NC" "core.fileMode"
    else
        printf '  %s[!!]%s %-22s should be false (avoids chmod noise)\n' "$C_YELLOW" "$C_NC" "core.fileMode"
    fi
    printf '  env version: %s\n' "$(env_version)"
    [ "$fail" -eq 0 ] && printf '%sdoctor: all good%s\n' "$C_GREEN" "$C_NC" || { printf '%sdoctor: issues found%s\n' "$C_RED" "$C_NC"; return 1; }
}

cmd_list() {
    printf '%-26s %-10s %s\n' "PROJECT" "PRESENT" "STATUS"
    while IFS=$'\t' read -r name url branch board; do
        [ -n "$name" ] || continue
        local dir="$HPMDEV_PROJECTS_DIR/$name"
        if [ -d "$dir/.git" ]; then
            local st; st="$(git -C "$dir" status --porcelain | wc -l | tr -d ' ')"
            local br; br="$(git -C "$dir" branch --show-current 2>/dev/null || echo '-')"
            printf '%-26s %-10s branch=%s dirty=%s\n' "$name" "yes" "$br" "$st"
        else
            printf '%-26s %-10s (declare in projects.yaml; run: hpmdev clone %s)\n' "$name" "no" "$name"
        fi
    done < <(manifest_pairs || true)
}

cmd_clone() {
    local want="${1:-}"
    local found=0
    while IFS=$'\t' read -r name url branch board; do
        [ -n "$name" ] || continue
        if [ -n "$want" ] && [ "$want" != "$name" ]; then continue; fi
        found=1
        local dir="$HPMDEV_PROJECTS_DIR/$name"
        if [ -d "$dir/.git" ]; then
            info "already present: $name"
            continue
        fi
        mkdir -p "$HPMDEV_PROJECTS_DIR"
        info "cloning $name <- $url ($branch)"
        if [ -n "$branch" ]; then
            git clone --branch "$branch" "$url" "$dir"
        else
            git clone "$url" "$dir"
        fi
        sync_config_one "$dir"
    done < <(manifest_pairs || die "cannot read manifest (python3-yaml required)")
    [ "$found" -eq 1 ] || die "project not in manifest: ${want:-<all>}"
}

cmd_sync_config() {
    local target="${1:-}"
    [ -n "$target" ] || die "usage: hpmdev sync-config <name>|--all"
    if [ "$target" = "--all" ]; then
        sync_config_one "$HPMDEV_TEMPLATES_DIR/$HPMDEV_DEFAULT_TEMPLATE"
        for d in "$HPMDEV_PROJECTS_DIR"/*/; do [ -d "$d" ] && sync_config_one "${d%/}"; done
    elif [ -d "$target" ]; then
        sync_config_one "$target"
    else
        sync_config_one "$HPMDEV_PROJECTS_DIR/$target"
    fi
}

write_workspace_file() {
    local name="$1" dir="$2" board="$3"
    local sdk_rel shared_rel
    sdk_rel="$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[2], sys.argv[1]))' "$dir" "$HPMDEV_SDK_DIR")"
    shared_rel="$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[2], sys.argv[1]))' "$dir" "$HPMDEV_SHARED_DIR")"
    cat > "$dir/${name}.code-workspace" <<EOF
{
  "folders": [
    { "name": "${name}", "path": "." },
    { "name": "hpm_sdk", "path": "${sdk_rel}" },
    { "name": "shared", "path": "${shared_rel}" }
  ],
  "settings": {
    "clangd.path": "clangd",
    "clangd.arguments": ["--log=error", "--background-index", "--header-insertion=never"],
    "C_Cpp.intelliSenseEngine": "disabled",
    "cmake.configureOnOpen": false,
    "files.exclude": { "**/.git": true, "**/.cache": true, "**/build": true, "**/output": true },
    "search.exclude": { "**/.cache": true, "**/.venv": true, "**/build": true, "**/output": true },
    "files.watcherExclude": { "**/.cache/**": true, "**/.venv/**": true, "**/build/**": true, "**/output/**": true },
    "cSpell.enabled": true,
    "cSpell.language": "en,zh-CN",
    "cSpell.useGitignore": true,
    "editor.formatOnSave": false,
    "terminal.integrated.cwd": "."
  }
}
EOF
    printf '  -> %s/%s.code-workspace (board=%s)\n' "$dir" "$name" "$board"
}

cmd_new() {
    local name="" template="$HPMDEV_DEFAULT_TEMPLATE" board=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --template) template="${2:?}"; shift 2 ;;
            --board)    board="${2:?}"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$name" ] || die "unexpected arg: $1"; name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: hpmdev new <name> [--template <t>] [--board <board>]"
    [[ "$name" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || die "invalid project name: $name"

    local tpl="$HPMDEV_TEMPLATES_DIR/$template"
    [ -d "$tpl" ] || die "template not found: $tpl"
    local dir="$HPMDEV_PROJECTS_DIR/$name"
    [ -e "$dir" ] && die "already exists: $dir"
    mkdir -p "$HPMDEV_PROJECTS_DIR"

    info "creating $name from template '$template'"
    cp -a "$tpl" "$dir"
    rm -rf "$dir/build" "$dir/output" "$dir/.cache"
    rm -f "$dir"/*.code-workspace
    board="${board:-${name}_board}"

    if [ -d "$dir/Board/user_board" ]; then
        mv "$dir/Board/user_board" "$dir/Board/$board"
        [ -f "$dir/Board/$board/user_board.yaml" ] && mv "$dir/Board/$board/user_board.yaml" "$dir/Board/$board/$board.yaml"
        [ -f "$dir/Board/$board/user_board.cfg" ]  && mv "$dir/Board/$board/user_board.cfg"  "$dir/Board/$board/$board.cfg"
        find "$dir/Board/$board" -type f -exec sed -i "s/user_board/${board}/g" {} +
    fi
    [ -f "$dir/Makefile" ] && sed -i "s/^BOARD ?= .*/BOARD ?= ${board}/" "$dir/Makefile"

    sync_config_one "$dir"

    if command -v git >/dev/null 2>&1; then
        git -C "$dir" init -q
        git -C "$dir" config core.fileMode false
        git -C "$dir" add -A
        git -C "$dir" -c user.name=hpmdev -c user.email=hpmdev@local \
            commit -q -m "chore: scaffold ${name} from ${template}" || true
    fi
    echo ""
    info "done. next:"
    printf '    cd %s\n    make build\n' "$dir"
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        new)         cmd_new "$@" ;;
        clone)       cmd_clone "$@" ;;
        list)        cmd_list "$@" ;;
        sync-config) cmd_sync_config "$@" ;;
        doctor)      cmd_doctor "$@" ;;
        env)         cmd_env "$@" ;;
        help|-h|--help) usage ;;
        *) error "unknown command: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
